{
  "name": "PLAYVERSE",
  "short_name": "PLAYVERSE",
  "description": "Four sports. One universe. Cross-platform multiplayer Tennis, Bowling, Golf and Racing.",
  "id": "/",
  "start_url": "/hub",
  "scope": "/",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#0b1020",
  "theme_color": "#0b1020",
  "categories": ["games", "sports"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Play bowling", "url": "/play/bowling", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Play tennis", "url": "/play/tennis", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Play golf", "url": "/play/golf", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Play racing", "url": "/play/racing", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
